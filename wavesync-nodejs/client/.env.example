# API Keys for Global Content Integration
# Get your free API keys from:

# Spotify API (for music data)
# Sign up at: https://developer.spotify.com/dashboard
VITE_SPOTIFY_CLIENT_ID=your_spotify_client_id_here
VITE_SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# Last.fm API (for charts and music info)
# Get key at: https://www.last.fm/api/account/create
VITE_LASTFM_API_KEY=your_lastfm_api_key_here

# ListenNotes API (for podcasts)
# Free tier at: https://www.listennotes.com/api/
VITE_LISTENNOTES_API_KEY=your_listennotes_api_key_here

# Note: iTunes API doesn't require a key and works out of the box!
